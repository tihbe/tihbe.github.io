---
import Base from '../layouts/Base.astro';
import ShaderCanvas from '../components/ShaderCanvas.astro';
import PostCard from '../components/PostCard.astro';
import PubRow from '../components/PubRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const selectedPubs = [
  {
    year: 2026,
    authors: 'Garg, N., Balafrej, I., Palhares, J., et al.',
    title: 'Unsupervised local learning based on voltage-dependent synaptic plasticity for resistive and ferroelectric synapses.',
    venue: 'Communications Materials (2026)',
    doi: '10.1038/s43246-025-01033-5',
  },
  {
    year: 2025,
    authors: 'Balafrej, I., Bahadi, S., Rouat, J., Alibart, F.',
    title: 'Enhancing Temporal Learning in Recurrent Spiking Networks for Neuromorphic Applications.',
    venue: 'Neuromorphic Computing and Engineering (2025)',
    doi: '10.1088/2634-4386/add293',
  },
  {
    year: 2023,
    authors: 'Balafrej, I., Janzakova, K., Kumar, A., Garg, N., et al.',
    title: 'Structural Plasticity for Neuromorphic Networks with Electropolymerized Dendritic PEDOT Connections.',
    venue: 'Nature Communications (2023)',
    doi: '10.1038/s41467-023-43887-8',
  },
];
---

<Base title="Ismael Balafrej" description="ML researcher & engineer. PhD in neuromorphic computing. Montreal.">

  <section class="hero">
    <ShaderCanvas />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 class="hero-name">Ismael Balafrej</h1>
      <p class="hero-tagline">
        I work on machine learning across the compute spectrum,<br />
        from neuromorphic hardware to large-scale training. Based in Montreal.
      </p>
      <ul class="hero-actions">
        <li><a href="/blog" class="link-cta">Read the blog</a></li>
        <li><a href="/publications" class="link-cta">Publications</a></li>
      </ul>
    </div>
  </section>

  <section class="split">
    <div class="split-inner">
      <div class="split-col">
        <div class="col-head">
          <h2>Recent posts</h2>
          <a href="/blog" class="col-more">All posts →</a>
        </div>
        <div class="col-list">
          {posts.map(p => (
            <PostCard
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              slug={p.id}
              tags={p.data.tags}
            />
          ))}
        </div>
      </div>

      <div class="split-col">
        <div class="col-head">
          <h2>Recent publications</h2>
          <a href="/publications" class="col-more">All papers →</a>
        </div>
        <div class="col-list">
          {selectedPubs.map(p => (
            <PubRow
              authors={p.authors}
              title={p.title}
              venue={p.venue}
              year={p.year}
              doi={p.doi}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    height: min(100svh, 780px);
    min-height: 520px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to top,
        color-mix(in oklch, var(--color-paper) 92%, transparent) 0%,
        color-mix(in oklch, var(--color-paper) 65%, transparent) 35%,
        transparent 70%
      );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding: var(--space-2xl) var(--space-md) var(--space-2xl);
    width: 100%;
    margin-inline: auto;
  }

  .hero-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
    max-width: 14ch;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 46ch;
    margin: 0 0 var(--space-lg);
  }

  .hero-actions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }

  .split {
    padding: var(--space-2xl) var(--space-md) var(--space-xl);
  }

  .split-inner {
    max-width: 1120px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
  }

  .split-col {
    min-width: 0;
  }

  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .col-head h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-xl);
    color: var(--color-ink);
    letter-spacing: -0.015em;
    margin: 0;
  }

  .col-more {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .col-more:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .split-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 460px;
    }
    .hero-content {
      padding: var(--space-xl) var(--space-md);
    }
    .split {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>
