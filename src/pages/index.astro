---
import Base from '../layouts/Base.astro';
import ShaderCanvas from '../components/ShaderCanvas.astro';
import PostCard from '../components/PostCard.astro';
import PubRow from '../components/PubRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const selectedPubs = [
  {
    year: 2026,
    authors: 'Garg, N., Balafrej, I., Palhares, J., et al.',
    title: 'Unsupervised local learning based on voltage-dependent synaptic plasticity for resistive and ferroelectric synapses.',
    venue: 'Communications Materials (2026)',
    doi: '10.1038/s43246-025-01033-5',
  },
  {
    year: 2025,
    authors: 'Balafrej, I., Bahadi, S., Rouat, J., Alibart, F.',
    title: 'Enhancing Temporal Learning in Recurrent Spiking Networks for Neuromorphic Applications.',
    venue: 'Neuromorphic Computing and Engineering (2025)',
    doi: '10.1088/2634-4386/add293',
  },
  {
    year: 2023,
    authors: 'Balafrej, I., Janzakova, K., Kumar, A., Garg, N., et al.',
    title: 'Structural Plasticity for Neuromorphic Networks with Electropolymerized Dendritic PEDOT Connections.',
    venue: 'Nature Communications (2023)',
    doi: '10.1038/s41467-023-43887-8',
  },
];
---

<Base title="Ismael Balafrej" description="ML researcher & engineer. PhD in neuromorphic computing. Montreal.">

  <!-- Hero -->
  <section class="hero">
    <ShaderCanvas />
    <div class="hero-content">
      <h1>Ismael Balafrej</h1>
      <p class="hero-tagline">
        I work on machine learning across the compute spectrum,<br />
        from neuromorphic chips to large-scale training. Based in Montreal.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn-primary">Read the blog</a>
        <a href="/publications" class="btn-secondary">Publications</a>
      </div>
    </div>
    <a href="#latest" class="scroll-hint" aria-label="Scroll down">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M8 3 L8 13 M4 9 L8 13 L12 9" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <!-- Recent posts -->
  <section id="latest" class="section">
    <div class="section-inner">
      <div class="section-header reveal">
        <h2>Recent posts</h2>
        <a href="/blog" class="see-all">All posts →</a>
      </div>
      <div class="post-grid">
        {posts.map(p => (
          <PostCard
            title={p.data.title}
            description={p.data.description}
            date={p.data.date}
            slug={p.id}
            tags={p.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected publications -->
  <section class="section section-pubs">
    <div class="section-inner section-inner--narrow">
      <div class="section-header reveal">
        <h2>Recent publications</h2>
        <a href="/publications" class="see-all">All papers →</a>
      </div>
      <div class="pub-list">
        {selectedPubs.map(p => (
          <PubRow
            authors={p.authors}
            title={p.title}
            venue={p.venue}
            year={p.year}
            doi={p.doi}
          />
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }


  .hero-content h1 {
    margin-bottom: 1rem;
    text-shadow: 0 2px 40px rgba(0,0,0,0.8);
  }

  .hero-tagline {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 2rem;
    text-shadow: 0 1px 20px rgba(0,0,0,0.9);
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    padding: 0.6em 1.4em;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover { opacity: 0.87; transform: translateY(-1px); text-decoration: none; }

  .btn-secondary {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--color-rule);
    color: var(--color-text);
    padding: 0.6em 1.4em;
    border-radius: 4px;
    font-size: 0.875rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
    backdrop-filter: blur(6px);
  }
  .btn-secondary:hover { border-color: var(--color-muted); transform: translateY(-1px); text-decoration: none; }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    color: var(--color-muted);
    animation: bounce 2.5s ease-in-out infinite;
    text-decoration: none;
  }
  .scroll-hint:hover { text-decoration: none; }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }

  .section {
    padding: 5rem 1.5rem;
  }

  .section-pubs {
    background: var(--color-surface);
    border-top: 1px solid var(--color-rule);
  }

  .section-inner {
    max-width: 1100px;
    margin-inline: auto;
  }

  .section-inner--narrow {
    max-width: 860px;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .see-all {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
    transition: color 0.2s;
    text-decoration: none;
  }
  .see-all:hover { color: var(--color-accent); text-decoration: none; }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .pub-list {
    border-top: 1px solid var(--color-rule);
  }
</style>
