---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog" description="Posts on machine learning, neuromorphic computing, and data science by Ismael Balafrej.">
  <div class="blog-page">
    <header class="page-header reveal">
      <h1>Blog</h1>
      <p>Machine learning, neuromorphic computing, data science.</p>
      <a href="/rss.xml" class="rss-btn">RSS feed</a>
    </header>

    <div class="post-grid">
      {posts.map(p => (
        <PostCard
          title={p.data.title}
          description={p.data.description}
          date={p.data.date}
          slug={p.id}
          tags={p.data.tags}
        />
      ))}
    </div>
  </div>
</Base>

<style>
  .blog-page {
    max-width: 1100px;
    margin-inline: auto;
    padding: 5rem 1.5rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .page-header h1 { margin-bottom: 0.15rem; }

  .page-header p {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .rss-btn {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    padding: 0.25em 0.75em;
    border-radius: 4px;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
  }
  .rss-btn:hover { color: var(--color-accent); border-color: rgba(124,109,250,0.4); text-decoration: none; }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
</style>
