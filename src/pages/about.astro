  },
  {
    label: 'Semantic Scholar',
    href: 'https://www.semanticscholar.org/author/Ismael-Balafrej/1942665571',
    external: true,
    svg: '<path d="M14.73 2.676 8.313 19.321h2.16l1.336-3.733h6.474l1.344 3.733H21.8L15.37 2.676ZM12.52 13.9l2.614-7.408 2.616 7.408Zm-5.47 1.845a5.323 5.323 0 0 1-3.712 1.51C1.497 17.255 0 15.756 0 13.903c0-1.855 1.497-3.353 3.338-3.353.84 0 1.55.295 2.14.754L6.74 9.95a5.15 5.15 0 0 0-3.4-1.28C1.497 8.67 0 10.17 0 12.02c0 1.855 1.497 3.354 3.338 3.354a5.33 5.33 0 0 0 3.712-1.51Z"/>',
