<style>
  .about-page {
    max-width: 900px;
    margin-inline: auto;
    padding: 5rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .about-page {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .about-avatar {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-rule);
    display: block;
  }

  .about-links {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .about-links a {
    font-size: 0.82rem;
    color: var(--color-muted);
    transition: color 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .about-links a:hover { color: var(--color-accent); }

  .about-body h1 {
    margin-bottom: 2rem;
  }

  .prose > * + * {
    margin-top: 1.35rem;
  }

  .prose p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .prose em {
    color: var(--color-text);
    font-style: normal;
  }
</style>
