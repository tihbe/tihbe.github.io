---
import Base from '../layouts/Base.astro';

interface Project {
  title: string;
  description: string;
  type: 'web' | 'package';
  url: string;
  screenshot?: string;
  badge?: string;
  badgeUrl?: string;
}

const projects: Project[] = [
  {
    title: 'RunScan',
    description: 'Take a photo of your treadmill screen and it logs the run to Strava. AI reads pace, distance, and time off the display. No manual entry.',
    type: 'web',
    url: 'https://runscan.ibapps.net',
    screenshot: '/screenshots/runscan.png',
  },
  {
    title: 'ebdataset',
    description: 'Python API for loading event-based neuromorphic datasets. Covers 7 datasets including IBM DVS Gestures, N-MNIST, and NCaltech101, with sparse NumPy and dense PyTorch representations.',
    type: 'package',
    url: 'https://pypi.org/project/ebdataset/',
    badge: 'PyPI',
    badgeUrl: 'https://pypi.org/project/ebdataset/',
  },
  {
    title: 'Notes',
    description: 'Note-taking app with no backend. Everything is stored in the URL itself, compressed. Share a note by sharing the link.',
    type: 'web',
    url: 'https://notes.ibapps.net',
    screenshot: '/screenshots/notes.png',
  },
  {
    title: 'WordChain',
    description: 'A word puzzle game where each move connects words one letter at a time. Simple rules, satisfying chains.',
    type: 'web',
    url: 'https://wordchain.ibapps.net',
    screenshot: '/screenshots/wordchain.png',
  },
  {
    title: 'Sound Meter',
    description: 'Ambient sound analyzer that runs in the browser. Measures decibel levels and shows frequency content in real time, straight from the microphone. Nothing is installed, nothing is sent anywhere.',
    type: 'web',
    url: 'https://sound.ibapps.net',
    screenshot: '/screenshots/sound.png',
  },
  {
    title: 'dirlog',
    description: 'Python utility for ML experiment logging. Run it once and it creates a timestamped directory for the experiment, then saves configs, results, and logs with a minimal API.',
    type: 'package',
    url: 'https://github.com/tihbe/dirlog',
    badge: 'GitHub',
    badgeUrl: 'https://github.com/tihbe/dirlog',
  },
];

const cleanUrl = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Base
  title="Projects"
  description="Personal projects by Ismael Balafrej — web tools, Python packages, and side experiments."
>
  <article class="projects-page">
    <header class="page-head">
      <h1>Projects</h1>
      <p>Side projects, tools, and experiments.</p>
    </header>

    <div class="proj-list">
      {projects.map(p => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="proj-row"
          data-kind={p.type}
        >
          <div class="proj-visual">
            {p.screenshot ? (
              <img src={p.screenshot} alt="" loading="lazy" />
            ) : (
              <div class="proj-mark" aria-hidden="true">
                <span class="proj-mark-type">{p.badge ?? 'package'}</span>
              </div>
            )}
          </div>

          <div class="proj-body">
            <div class="proj-head">
              <h2 class="proj-title">{p.title}</h2>
              <span class="proj-kind">{p.type === 'web' ? 'web app' : (p.badge ?? 'package').toLowerCase()}</span>
            </div>
            <p class="proj-desc">{p.description}</p>
            <span class="proj-url">
              {cleanUrl(p.url)}
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 10L10 2M10 2H5M10 2v5"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </article>
</Base>

<style>
  .projects-page {
    max-width: 1000px;
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .page-head {
    margin-bottom: var(--space-2xl);
  }
  .page-head h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-2xs);
  }
  .page-head p {
    color: var(--color-ink-2);
    font-size: var(--text-md);
    max-width: 48ch;
  }

  .proj-list {
    display: flex;
    flex-direction: column;
    border-top: var(--rule-hair);
  }

  .proj-row {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: var(--rule-hair);
    text-decoration: none;
    color: inherit;
    align-items: start;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .proj-row:hover { text-decoration: none; }

  .proj-visual {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-paper-2);
    border: var(--rule-hair);
    min-width: 0;
  }
  .proj-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    filter: saturate(0.9) brightness(0.9);
    transition: filter var(--dur-med) var(--ease-out);
  }
  .proj-row:hover .proj-visual img {
    filter: saturate(1) brightness(1);
  }

  .proj-mark {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-paper-2);
  }
  .proj-mark-type {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    letter-spacing: 0.02em;
  }

  .proj-body {
    min-width: 0;
    padding-top: var(--space-3xs);
  }

  .proj-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xs);
    flex-wrap: wrap;
  }

  .proj-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-xl);
    color: var(--color-ink);
    letter-spacing: -0.015em;
    margin: 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .proj-row:hover .proj-title {
    color: var(--color-accent);
  }

  .proj-kind {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    letter-spacing: 0.02em;
  }

  .proj-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
    max-width: 56ch;
  }

  .proj-url {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    letter-spacing: 0.005em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .proj-row:hover .proj-url {
    color: var(--color-accent);
  }
  .proj-url svg { flex-shrink: 0; }

  @media (max-width: 700px) {
    .proj-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-sm);
    }
    .proj-visual {
      aspect-ratio: 16 / 9;
    }
    .proj-title {
      font-size: var(--text-lg);
    }
  }
</style>
