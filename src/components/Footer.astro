---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <span class="footer-name">Ismael Balafrej</span>
    <span class="sep">&mdash;</span>
    <span class="footer-year">{year}</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-rule);
    padding: 1.75rem 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1100px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .footer-name { color: var(--color-text); }
  .sep { opacity: 0.35; }
</style>
