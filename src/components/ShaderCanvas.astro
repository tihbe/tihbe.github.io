---
// Dithered radial wave interference hero background.
// Source: N point sources on Lissajous paths, each emitting circular ripples.
// Brightness = superposition of sin(dist · freq − t · speed) · attenuation(dist).
// Each "pixel" is one of 4 pre-rendered circle tiles.
// Ordered dithering via a Bayer matrix maps brightness → tile index.
//
// Palette derived from design.md tokens:
//   bg  ≈ oklch(15% 0.005 240)  → #101114  (paper)
//   fg  ≈ oklch(35% 0.045 220)  → #1e3040  (dim phosphor cyan, cool)
---

<canvas id="dither-canvas" aria-hidden="true"></canvas>

<style>
  #dither-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: var(--color-paper);
  }
</style>

<script>
const CFG = {
  cellSize: 12,
  pixelRatio: 0,

  fps: 24,
  speed: 0.22,

  sources: [
    { ax: 1.3, ay: 1.7, phiX: 0.00, phiY: 1.10 },
    { ax: 2.1, ay: 0.9, phiX: 2.30, phiY: 0.50 },
    { ax: 1.7, ay: 2.3, phiX: 1.50, phiY: 3.10 },
    { ax: 0.8, ay: 1.4, phiX: 4.20, phiY: 2.00 },
    { ax: 2.5, ay: 1.1, phiX: 0.90, phiY: 4.50 },
  ],
  orbitRadius: 0.44,
  waveFreq: 4.2,
  waveSpeed: 2.2,
  attenuation: 4.0,

  vignetteStrength: 0.82,
  vignetteExponent: 1.6,

  bayerSize: 4,
  ditherAmp: 0.9,

  // Phosphor-cyan tiles — dim CRT/scope trace on paper.
  tiles: [
    { bg: '#101114', fg: '#1e3040', radius: 0.47 },
    { bg: '#101114', fg: '#1e3040', radius: 0.24 },
    { bg: '#1e3040', fg: '#101114', radius: 0.24 },
    { bg: '#1e3040', fg: '#101114', radius: 0.47 },
  ],

  brightnessBias: -0.08,

  mouseLerp: 0.05,
  mouseStrength: 0.07,

  touchStrength: 0.6,
  touchDecay: 4.0,
  touchAttenuation: 1.8,
  touchMaxAge: 1400,
};

const BAYER: Record<number, number[]> = {
  2: [0, 2, 3, 1],
  4: [
     0,  8,  2, 10,
    12,  4, 14,  6,
     3, 11,  1,  9,
    15,  7, 13,  5,
  ],
  8: [
     0, 32,  8, 40,  2, 34, 10, 42,
    48, 16, 56, 24, 50, 18, 58, 26,
    12, 44,  4, 36, 14, 46,  6, 38,
    60, 28, 52, 20, 62, 30, 54, 22,
     3, 35, 11, 43,  1, 33,  9, 41,
    51, 19, 59, 27, 49, 17, 57, 25,
    15, 47,  7, 39, 13, 45,  5, 37,
    63, 31, 55, 23, 61, 29, 53, 21,
  ],
};

function buildBayer(size: number): Float32Array {
  const raw = BAYER[size] ?? BAYER[4];
  const n2 = size * size;
  const out = new Float32Array(n2);
  for (let i = 0; i < n2; i++) out[i] = raw[i] / n2;
  return out;
}

function makeTile(cell: number, tile: typeof CFG.tiles[0]): OffscreenCanvas {
  const c = new OffscreenCanvas(cell, cell);
  const ctx = c.getContext('2d')!;
  ctx.fillStyle = tile.bg;
  ctx.fillRect(0, 0, cell, cell);
  const r = tile.radius * cell;
  if (r > 0.5) {
    ctx.fillStyle = tile.fg;
    ctx.beginPath();
    ctx.arc(cell / 2, cell / 2, r, 0, Math.PI * 2);
    ctx.fill();
  }
  return c;
}

let stopAnimation: (() => void) | null = null;

function run() {
  stopAnimation?.();
  stopAnimation = null;

  const canvas = document.getElementById('dither-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;

  const ctx = canvas.getContext('2d')!;
  const bayerMatrix = buildBayer(CFG.bayerSize);
  const bayerN      = CFG.bayerSize;
  const numTiles    = CFG.tiles.length;

  let tiles: OffscreenCanvas[] = CFG.tiles.map(t => makeTile(CFG.cellSize, t));
  let W = 0, H = 0, cols = 0, rows = 0;
  let cellSize = CFG.cellSize;

  const ro = new ResizeObserver(resize);

  function resize() {
    const pr = CFG.pixelRatio > 0 ? CFG.pixelRatio : Math.min(devicePixelRatio, 2);
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    canvas.width  = Math.round(W * pr);
    canvas.height = Math.round(H * pr);
    ctx.resetTransform();
    ctx.scale(pr, pr);
    cellSize = Math.max(6, Math.round(CFG.cellSize * W / 1280));
    cols = Math.ceil(W / cellSize) + 1;
    rows = Math.ceil(H / cellSize) + 1;
    tiles = CFG.tiles.map(t => makeTile(cellSize, t));
  }

  ro.observe(canvas);
  resize();

  let mouseTargetX = 0.5, mouseTargetY = 0.5;
  let virtualX     = 0.5, virtualY     = 0.5;
  let mouseInside  = false;

  function onMouseMove(e: MouseEvent) {
    const rect = canvas.getBoundingClientRect();
    mouseTargetX = (e.clientX - rect.left)  / rect.width;
    mouseTargetY = (e.clientY - rect.top)   / rect.height;
    mouseInside  = true;
  }
  function onMouseLeave() { mouseInside = false; }

  canvas.addEventListener('mousemove', onMouseMove);
  canvas.addEventListener('mouseleave', onMouseLeave);

  interface Pulse { x: number; y: number; t0: number; }
  let pulses: Pulse[] = [];

  function onTouchStart(e: TouchEvent) {
    const rect = canvas.getBoundingClientRect();
    for (const touch of e.changedTouches) {
      pulses.push({
        x:  (touch.clientX - rect.left) / rect.width,
        y:  (touch.clientY - rect.top)  / rect.height,
        t0: performance.now(),
      });
    }
  }

  canvas.addEventListener('touchstart', onTouchStart, { passive: true });

  let frameNow = 0;

  function brightness(nx: number, ny: number, t: number): number {
    let v = 0;
    for (const s of CFG.sources) {
      const sx = 0.5 + CFG.orbitRadius * Math.sin(s.ax * t + s.phiX);
      const sy = 0.5 + CFG.orbitRadius * Math.sin(s.ay * t + s.phiY);
      const dx = nx - sx;
      const dy = ny - sy;
      const d  = Math.sqrt(dx * dx + dy * dy);
      const wave = Math.sin(d * CFG.waveFreq * Math.PI * 2 - t * CFG.waveSpeed);
      const att  = 1 / (1 + d * CFG.attenuation);
      v += wave * att;
    }
    v = v / CFG.sources.length * 0.5 + 0.5 + CFG.brightnessBias;

    if (mouseInside) {
      const mdx = nx - virtualX, mdy = ny - virtualY;
      const md  = Math.sqrt(mdx * mdx + mdy * mdy);
      const mWave = Math.sin(md * CFG.waveFreq * Math.PI * 2 - t * CFG.waveSpeed);
      const mAtt  = 1 / (1 + md * CFG.attenuation);
      v += mWave * mAtt * CFG.mouseStrength;
    }

    for (const p of pulses) {
      const elapsed = (frameNow - p.t0) / 1000;
      const decay   = Math.exp(-CFG.touchDecay * elapsed);
      const pdx = nx - p.x, pdy = ny - p.y;
      const pd  = Math.sqrt(pdx * pdx + pdy * pdy);
      const pWave = Math.sin(pd * CFG.waveFreq * Math.PI * 2 - t * CFG.waveSpeed);
      const pAtt  = 1 / (1 + pd * CFG.touchAttenuation);
      v += pWave * pAtt * CFG.touchStrength * decay;
    }

    const dx = nx - 0.5, dy = ny - 0.5;
    const d  = Math.min(1, Math.sqrt(dx * dx + dy * dy) * Math.SQRT2);
    v *= 1 - CFG.vignetteStrength * Math.pow(d, CFG.vignetteExponent);

    return Math.max(0, Math.min(1, v));
  }

  const msPerFrame = 1000 / CFG.fps;
  let lastFrame = 0;
  let t0 = performance.now();
  let raf = 0;

  function frame(now: number) {
    raf = requestAnimationFrame(frame);
    if (now - lastFrame < msPerFrame - 1) return;
    lastFrame = now;
    frameNow  = now;

    virtualX += (mouseTargetX - virtualX) * CFG.mouseLerp;
    virtualY += (mouseTargetY - virtualY) * CFG.mouseLerp;

    pulses = pulses.filter(p => now - p.t0 < CFG.touchMaxAge);

    const t = (now - t0) / 1000 * CFG.speed;

    for (let row = 0; row < rows; row++) {
      const ny = row / (rows - 1);
      for (let col = 0; col < cols; col++) {
        const nx = col / (cols - 1);

        const b        = brightness(nx, ny, t);
        const bayerVal = bayerMatrix[(row % bayerN) * bayerN + (col % bayerN)];
        const step     = 1 / numTiles;
        const dithered = b + (bayerVal - 0.5) * step * CFG.ditherAmp;
        const idx      = Math.max(0, Math.min(numTiles - 1, Math.floor(dithered * numTiles)));

        ctx.drawImage(tiles[idx], col * cellSize, row * cellSize);
      }
    }
  }

  function onVisibility() {
    if (document.hidden) {
      cancelAnimationFrame(raf);
    } else {
      t0 = performance.now() - (lastFrame / CFG.speed * 1000);
      raf = requestAnimationFrame(frame);
    }
  }
  document.addEventListener('visibilitychange', onVisibility);

  raf = requestAnimationFrame(frame);

  stopAnimation = () => {
    cancelAnimationFrame(raf);
    ro.disconnect();
    canvas.removeEventListener('mousemove', onMouseMove);
    canvas.removeEventListener('mouseleave', onMouseLeave);
    canvas.removeEventListener('touchstart', onTouchStart);
    document.removeEventListener('visibilitychange', onVisibility);
  };
}

// Render a single frozen frame for reduced-motion users so the hero
// still carries the same visual character without any animation.
function renderStatic() {
  const canvas = document.getElementById('dither-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const bayerMatrix = buildBayer(CFG.bayerSize);
  const bayerN = CFG.bayerSize;
  const numTiles = CFG.tiles.length;
  const pr = Math.min(devicePixelRatio, 2);
  const W = canvas.clientWidth;
  const H = canvas.clientHeight;
  canvas.width  = Math.round(W * pr);
  canvas.height = Math.round(H * pr);
  ctx.scale(pr, pr);
  const cellSize = Math.max(6, Math.round(CFG.cellSize * W / 1280));
  const cols = Math.ceil(W / cellSize) + 1;
  const rows = Math.ceil(H / cellSize) + 1;
  const tiles = CFG.tiles.map(t => makeTile(cellSize, t));
  const t = 0.5;

  for (let row = 0; row < rows; row++) {
    const ny = row / (rows - 1);
    for (let col = 0; col < cols; col++) {
      const nx = col / (cols - 1);
      let v = 0;
      for (const s of CFG.sources) {
        const sx = 0.5 + CFG.orbitRadius * Math.sin(s.ax * t + s.phiX);
        const sy = 0.5 + CFG.orbitRadius * Math.sin(s.ay * t + s.phiY);
        const dx = nx - sx, dy = ny - sy;
        const d  = Math.sqrt(dx * dx + dy * dy);
        v += Math.sin(d * CFG.waveFreq * Math.PI * 2 - t * CFG.waveSpeed) / (1 + d * CFG.attenuation);
      }
      v = v / CFG.sources.length * 0.5 + 0.5 + CFG.brightnessBias;
      const dx = nx - 0.5, dy = ny - 0.5;
      const d  = Math.min(1, Math.sqrt(dx * dx + dy * dy) * Math.SQRT2);
      v *= 1 - CFG.vignetteStrength * Math.pow(d, CFG.vignetteExponent);
      v = Math.max(0, Math.min(1, v));

      const bayerVal = bayerMatrix[(row % bayerN) * bayerN + (col % bayerN)];
      const step = 1 / numTiles;
      const dithered = v + (bayerVal - 0.5) * step * CFG.ditherAmp;
      const idx = Math.max(0, Math.min(numTiles - 1, Math.floor(dithered * numTiles)));
      ctx.drawImage(tiles[idx], col * cellSize, row * cellSize);
    }
  }
}

document.addEventListener('astro:page-load', () => {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    renderStatic();
  } else {
    run();
  }
});

document.addEventListener('astro:before-swap', () => {
  stopAnimation?.();
  stopAnimation = null;
});
</script>
