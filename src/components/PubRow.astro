---
interface Props {
  authors: string;
  title: string;
  venue: string;
  year: number;
  doi?: string;
}

const { authors, title, venue, doi } = Astro.props;

const formattedAuthors = authors.replace(
  /\bBalafrej,?\s*I\.?\b/g,
  '<strong>$&</strong>'
);
---

<div class="pub-row reveal">
  <div class="pub-content">
    <p class="pub-authors" set:html={formattedAuthors} />
    <p class="pub-title">{title}</p>
    <p class="pub-venue">{venue}</p>
    {doi && (
      <a
        href={`https://doi.org/${doi}`}
        target="_blank"
        rel="noopener noreferrer"
        class="doi-link"
      >
        DOI ↗
      </a>
    )}
  </div>
</div>

<style>
  .pub-row {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .pub-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .pub-authors {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .pub-authors :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .pub-title {
    font-size: 0.97rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .pub-venue {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
  }

  .doi-link {
    margin-top: 0.35rem;
    display: inline-block;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    border: 1px solid rgba(124, 109, 250, 0.35);
    padding: 0.18em 0.65em;
    border-radius: 3px;
    transition: border-color 0.2s, opacity 0.2s;
    text-decoration: none;
  }
  .doi-link:hover {
    border-color: var(--color-accent);
    opacity: 0.85;
    text-decoration: none;
  }
</style>
