---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags: string[];
}

const { title, description, date, slug, tags } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
}).format(date);
---

<article class="post-card reveal">
  <a href={`/blog/${slug}`} class="card-link">
    <time datetime={date.toISOString()}>{formatted}</time>
    <h3>{title}</h3>
    <p>{description}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map(t => <li><span class="tag-pill">{t}</span></li>)}
      </ul>
    )}
  </a>
</article>

<style>
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    transition: border-color 0.25s, transform 0.25s;
    overflow: hidden;
  }
  .post-card:hover {
    border-color: rgba(124, 109, 250, 0.45);
    transform: translateY(-2px);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .card-link:hover { text-decoration: none; }

  time {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.1rem;
    color: var(--color-text);
    line-height: 1.3;
    transition: color 0.2s;
  }
  .post-card:hover h3 {
    color: var(--color-accent);
  }

  p {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }

  .tags {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
