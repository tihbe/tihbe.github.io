---
const links = [
  { label: 'Blog',         href: '/blog' },
  { label: 'Publications', href: '/publications' },
  { label: 'Projects',     href: '/projects' },
  { label: 'About',        href: '/about' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="masthead">
  <div class="mast-inner">
    <a href="/" class="wordmark" aria-label="Ismael Balafrej — home">
      Ismael Balafrej
    </a>

    <nav aria-label="Primary" class="mast-nav">
      {links.map(l => (
        <a
          href={l.href}
          class:list={['mast-link', { 'is-active': isActive(l.href) }]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <button
      id="nav-toggle"
      class="mast-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    {links.map(l => (
      <a
        href={l.href}
        class:list={['mobile-link', { 'is-active': isActive(l.href) }]}
      >
        {l.label}
      </a>
    ))}
  </div>
</header>

<style>
  .masthead {
    background: var(--color-paper);
    border-bottom: var(--rule-hair);
  }

  .mast-inner {
    max-width: 1120px;
    margin-inline: auto;
    padding: var(--space-md) var(--space-md);
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-ink);
    letter-spacing: -0.015em;
    margin-right: auto;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }
  .wordmark:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .mast-nav {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
  }

  .mast-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .mast-link:hover {
    color: var(--color-ink);
    text-decoration: none;
  }
  .mast-link.is-active {
    color: var(--color-ink);
    position: relative;
  }
  .mast-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--color-accent);
  }

  .mast-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    cursor: pointer;
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-input);
  }
  .mast-toggle:hover {
    color: var(--color-ink);
    border-color: var(--color-ink-3);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: var(--space-sm) var(--space-md) var(--space-md);
    gap: var(--space-2xs);
    border-top: var(--rule-hair);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    padding: var(--space-2xs) 0;
    text-decoration: none;
  }
  .mobile-link.is-active {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .mast-inner {
      padding: var(--space-sm) var(--space-md);
    }
    .mast-nav { display: none; }
    .mast-toggle { display: inline-block; }
    .wordmark { font-size: var(--text-md); }
  }
</style>

<script>
  function bindMenu() {
    const toggle = document.getElementById('nav-toggle');
    const menu   = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      menu.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(!menu.classList.contains('open'));
    });

    menu.querySelectorAll('a').forEach(a =>
      a.addEventListener('click', () => setOpen(false))
    );
  }

  document.addEventListener('astro:page-load', bindMenu);
</script>
