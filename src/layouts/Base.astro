---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'ML researcher & engineer. PhD in neuromorphic computing. Montreal.',
  ogImage = '/profile.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Ismael Balafrej' ? title : `${title} — Ismael Balafrej`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="author" content="Ismael Balafrej" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ismael Balafrej" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@IsmaelBalafrej" />
    <meta name="twitter:creator" content="@IsmaelBalafrej" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ismael Balafrej"
      href="/rss.xml"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VPT77KYSBR"></script>
    <script>
      // @ts-nocheck
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-VPT77KYSBR');
    </script>

    <ClientRouter />

    <title>{pageTitle}</title>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: var(--space-2xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    z-index: 200;
  }
  .skip-link:focus {
    left: var(--space-sm);
    top: var(--space-sm);
  }
</style>
