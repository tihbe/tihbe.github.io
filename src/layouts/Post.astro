---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(date);
---

<Base title={title} description={description}>
  <article class="post-article">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatted}</time>
        {tags.length > 0 && (
          <span class="post-tags">
            {tags.map((t, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <span class="post-tag">{t}</span>
              </>
            ))}
          </span>
        )}
      </div>
      <h1>{title}</h1>
      {description && <p class="post-desc">{description}</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-footer" aria-label="Post navigation">
      <a href="/blog" class="back-link">← All posts</a>
    </nav>
  </article>
</Base>

<style>
  .post-article {
    max-width: 720px;
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair);
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    letter-spacing: 0.01em;
  }

  time {
    color: var(--color-ink-3);
  }

  .post-tags { color: var(--color-ink-3); }
  .post-tag { text-transform: lowercase; }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .post-desc {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.6;
    max-width: var(--measure);
    margin: 0;
  }

  .post-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .back-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
</style>

<script>
  function wrapCodeBlocks() {
    document.querySelectorAll<HTMLElement>('.prose pre[data-language="python"]:not([data-wrapped])').forEach(pre => {
      pre.dataset.wrapped = '1';
      const details = document.createElement('details');
      details.className = 'code-block';
      const summary = document.createElement('summary');
      summary.textContent = 'python';
      details.appendChild(summary);
      pre.parentNode!.insertBefore(details, pre);
      details.appendChild(pre);
    });
  }

  document.addEventListener('astro:page-load', wrapCodeBlocks);
</script>
